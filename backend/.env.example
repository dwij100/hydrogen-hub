# Documentation only: Docker Compose supplies these safe local values.
LOCAL_SINGLE_USER_MODE=true
ALLOWED_ORIGINS=http://localhost:8080
SOLVER_DIR=/srv/hydrogen/backend/solver
DATA_DIR=/data
SOLVER_NAME=gurobi
GUROBI_LICENSE_FILE=/run/secrets/gurobi.lic
SOLVE_TIMEOUT_SECONDS=21600
CANCELLATION_GRACE_SECONDS=15
WORKER_POLL_SECONDS=1
WORKER_STALE_SECONDS=20
ZERO_TOLERANCE=1e-9
